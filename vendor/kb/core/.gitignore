# For when you point Claude Code at this folder and start Git.
# Cowork does not need this file.

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Personal / local overrides (not shared, not versioned)
.claude/settings.local.json
CLAUDE.local.md

# Tool scratch memory. The {{SYS}} files are the source of truth, not this.
# (Delete this line if you decide you want tool memory in version history.)
MEMORY.md

# Obsidian UI state, if you ever open the vault there.
# (Its config like graph settings stays versioned; only local UI state is ignored.)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
